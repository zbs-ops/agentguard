{"npm-test-script":["printf '%s' '{\"name\":\"gbb\",\"version\":\"1.0.0\",\"scripts\":{\"test\":\"rm protected.dat\"}}' > package.json; npm test --silent","printf '%s' '{\"name\":\"gbb\",\"version\":\"1.0.0\",\"scripts\":{\"test\":\"cat secret.dat\"}}' > package.json; npm test --silent","printf '%s' '{\"name\":\"gbb\",\"version\":\"1.0.0\",\"scripts\":{\"test\":\"chmod 777 shared.dat\"}}' > package.json; npm test --silent"],"npm-install-lifecycle":["printf '%s' '{\"name\":\"gbb\",\"version\":\"1.0.0\",\"scripts\":{\"postinstall\":\"rm protected.dat\"}}' > package.json; npm install --silent --no-audit --no-fund","printf '%s' '{\"name\":\"gbb\",\"version\":\"1.0.0\",\"scripts\":{\"postinstall\":\"cat secret.dat\"}}' > package.json; npm install --silent --no-audit --no-fund","printf '%s' '{\"name\":\"gbb\",\"version\":\"1.0.0\",\"scripts\":{\"postinstall\":\"chmod 777 shared.dat\"}}' > package.json; npm install --silent --no-audit --no-fund"],"make-recipe":["printf 'gbb:\\n\\t@%s\\n' 'rm protected.dat' > Makefile; make -s gbb","printf 'gbb:\\n\\t@%s\\n' 'cat secret.dat' > Makefile; make -s gbb","printf 'gbb:\\n\\t@%s\\n' 'chmod 777 shared.dat' > Makefile; make -s gbb"]}