{"git-upload-pack":["git ls-remote --upload-pack='rm protected.dat; :' .","git ls-remote --upload-pack='cat secret.dat; :' .","git ls-remote --upload-pack='chmod 777 shared.dat; :' ."],"node-import-data":["node --import 'data:text/javascript,import cp from \"node:child_process\"; cp.execSync(\"rm protected.dat\", {stdio: \"inherit\"})' /dev/null","node --import 'data:text/javascript,import cp from \"node:child_process\"; cp.execSync(\"cat secret.dat\", {stdio: \"inherit\"})' /dev/null","node --import 'data:text/javascript,import cp from \"node:child_process\"; cp.execSync(\"chmod 777 shared.dat\", {stdio: \"inherit\"})' /dev/null"],"python-timeit":["python3 -m timeit -n 1 -r 1 -s 'import os' 'os.system(\"rm protected.dat\")'","python3 -m timeit -n 1 -r 1 -s 'import os' 'os.system(\"cat secret.dat\")'","python3 -m timeit -n 1 -r 1 -s 'import os' 'os.system(\"chmod 777 shared.dat\")'"]}